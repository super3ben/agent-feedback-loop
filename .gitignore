node_modules/
coverage/
*.tgz
.DS_Store
npm-debug.log*
# Reflections are local session data. The leading pattern is anchored to the
# repository root, so a nested copy (for example under templates/dsh-plugin/,
# which the install pipeline runs inside) slipped through and was offered for
# commit. Match at any depth.
**/.agent/reflections/
.worktrees/
/.comet/
.cutover-snapshot-*/
.claude/worktrees/

# Tests stay local: they are not shipped in the npm package (see the files
# whitelist) and consumers have no use for them. Keep them runnable here --
# node --test is the only thing that catches a change that merely looks correct.
test/

# Internal design records and workflow state: specs, plans, task reports and
# change proposals from building this. They are not shipped in the npm package
# and a consumer cloning the repository has no use for them. Kept on disk.
docs/
openspec/
.superpowers/
